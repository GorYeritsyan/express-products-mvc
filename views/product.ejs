<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body>
    <%-include('header') %>
    <section>
      <div class="container">
        <h1><%= title %></h1>

        <div>
          <p>ID: <%=product.id%></p>
          <p>Title: <%= product.title %></p>
          <p>Price: <%= product.title %></p>
          <p>Category: <%=product.category %></p>
          <p><img width="60" src="<%=product.image %>" alt="" /></p>
          <button>Add to cart</button>
        </div>
      </div>
    </section>
  </body>
</html>
