<div class="pagination-wrapper">
  <% function pageLink(p) { %>
    <% if (p === pagination.currentPage) { %>
  <span class="add-btn" style="font-weight: bold"><%= p %></span>
  <% } else { %>
  <a class="pagination-btn" href="?page=<%= p %>"><%= p %></a>
  <% } %> <% } %>

  <!-- Prev -->
  <% if (pagination.currentPage > 1) { %>
  <a class="add-btn" href="?page=<%= pagination.currentPage - 1 %>">Prev</a>
  <% } %>

  <!-- Always show page 1 -->
  <% pageLink(1); %>

  <!-- Left "..." -->
  <% if (pagination.currentPage > 4) { %>
  <span class="pagination-btn">...</span>
  <% } %>

  <!-- Middle pages (current -2 to current +2) -->
  <% for (let i = pagination.currentPage - 2; i <= pagination.currentPage + 2; i++) { %>
     <% if (i > 1 && i < pagination.totalPages) { %> <% pageLink(i); %>
  <% } %> <% } %>

  <!-- Right "..." -->
  <% if (pagination.currentPage < pagination.totalPages - 3) { %>
  <span class="pagination-btn">...</span>
  <% } %>

  <!-- Always show last page -->
  <% if (pagination.totalPages > 1) { %> <% pageLink(pagination.totalPages); %>
  <% } %>

  <!-- Next -->
  <% if (pagination.currentPage < pagination.totalPages) { %>
  <a class="add-btn" href="?page=<%= pagination.currentPage + 1 %>">Next</a>
  <% } %>
</div>
